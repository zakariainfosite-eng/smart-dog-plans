{
  "name": "cynoplanning",
  "productName": "CynoPlanning",
  "version": "0.0.4",
  "description": "CynoPlanning desktop application",
  "author": "CynoPlanning",
  "private": true,
  "main": "dist-electron/boot.cjs",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run build:mobile",
    "build:web": "vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:sync:ios": "npm run build:mobile && npx cap sync ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "git:sync": "bash scripts/git-sync.sh",
    "dist": "npm run electron:build:win",
    "electron:icons:win": "node scripts/generate-app-icons.mjs",
    "electron:icons": "node scripts/generate-app-icons.mjs",
    "ios:icons": "node scripts/generate-ios-app-icon.mjs",
    "electron:build:main": "node scripts/build-electron.mjs",
    "electron:rebuild-native": "electron-rebuild -f -w better-sqlite3 -v 34.5.8",
    "electron:test-sqlite": "env -u ELECTRON_RUN_AS_NODE electron scripts/test-better-sqlite3-electron.cjs",
    "electron:verify-migrations": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-sqlite-migrations.cjs",
    "electron:verify-upgrade": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-sqlite-upgrade-from-legacy.cjs",
    "electron:verify-marital-store": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-agents-marital-store.cjs",
    "electron:verify-section-chief-link": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-section-chief-section-id.cjs",
    "electron:apply-migrations": "env -u ELECTRON_RUN_AS_NODE electron scripts/apply-pending-sqlite-migrations.cjs",
    "electron:verify-agent-history": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-agent-history-runtime.cjs",
    "electron:migrate-supabase": "npm run electron:build:main && env -u ELECTRON_RUN_AS_NODE electron scripts/run-supabase-to-sqlite-migration.cjs",
    "electron:dev": "npm run electron:build:main && concurrently -k -n vite,electron -c cyan,magenta \"vite dev\" \"wait-on http://127.0.0.1:8080 && env -u ELECTRON_RUN_AS_NODE cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:8080 electron .\"",
    "electron:build": "npm run electron:build:win",
    "electron:build:win": "npm run electron:icons:win && npm run electron:rebuild-native && npm run electron:build:main && vite build --config vite.desktop.config.ts && electron-builder --win nsis --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^5.7.4",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/ios": "^5.7.8",
    "@capacitor/share": "^5.0.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.168.18",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "11.10.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.3.6",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.0.10",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "prettier": "^3.7.3",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "wait-on": "^8.0.5"
  }
}
